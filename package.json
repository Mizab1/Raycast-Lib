{
  "name": "sandstone-raycast",
  "version": "1.1.0",
  "description": "A library created with Sandstone",
  "type": "module",
  "module": "./lib/index.js",
  "exports": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "workspaces": [
    "./",
    "test"
  ],
  "scripts": {
    "setup": "bun link && bun i",
    "dev:test-build": "cd test && bun dev:test-build",
    "dev:compile": "bun build --outfile=lib/index.js --packages=external src/index.ts",
    "dev:build": "bun dev:compile && bun tsc",
    "dev:watch": "sand watch --library",
    "prepublishOnly": "bun dev:build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "sandstone-cli": "^2.6.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/bun": "^1.3.8",
    "sandstone": "~1.2.36"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
